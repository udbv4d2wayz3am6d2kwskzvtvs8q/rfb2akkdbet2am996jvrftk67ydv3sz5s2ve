7,0.3831,0],[43.339,0.3732,0],[43.4223,0.3685,0],[43.5057,0.3668,0],[45.839,0.3622,0],[46.4223,0.366,0],[46.7557,0.3732,0],[46.9223,0.3805,0],[47.089,0.392,0],[47.2557,0.4094,0],[47.339,0.4208,0],[47.4223,0.4342,0],[47.589,0.4672,0],[47.839,0.527,0],[47.9223,0.5444,0],[48.0057,0.5563,0],[48.089,0.5628,0],[48.2557,0.5657,0],[49.8807,0.5748,1],[52.3807,0.5748,0],[52.7973,0.5732,0],[53.2973,0.5624,0],[54.2973,0.5325,0],[54.714,0.5223,0],[55.0473,0.5187,0],[55.7973,0.5611,1]],"captions":{"en":[[0,0.48,"Doesn't time be flyin'?"],[0.48,2.65,"Aye, when you're havin' fun."],[2.65,5.74,"Oh, be off to the pub now, Pádraic,\nif you're gonna be annoyin' us."],[5.74,7.87,"I don't have to be down there\nevery night, do I?"],[12.12,15.38,"ColmSonnyLarry's\nscared him off, I suppose."],[17.59,19.42,"What did you hear of ColmSonnyLarry?"],[19.96,22.92,"Didn't you and he\nused to be the best of friends?"],[22.92,24.3,"We're still the best of friends."],[24.3,25.72,"- MRS. McCORMICK: No, you're not.\n- Who says we're not?"],[25.72,26.8,"She says."],[26.8,28.26,"Ah, for God's sake, Siobhán."],[28.26,31.52,"I said nothing of the like,\nMrs. McCormick! I was just chatting."],[31.52,34.77,"Now, you go off to Jonjo's, Pádraic,\nand don't be getting under our feet."],[34.77,37.48,"Sure, Mrs. McCormick never gets a chance\nto come over for a chat."],[37.48,39.06,"She never gets a chance\n'cause you avoid her."],[39.06,40.15,"I do not avoid her!"],[40.15,42.65,"You hide behind walls\nif she's coming up the road."],[43.53,45.07,"I do not"],[45.7,47.66,"h... hide behind walls."],[59.88,61.25,"Good luck to ye."]],"ru":[[0,0.48,"Время летит."],[0.48,2.65,"Да, когда тебе весело."],[2.65,5.74,"Если будешь нас бесить, Падрик,\nто лучше иди в паб."],[5.74,7.87,"Я не обязан ходить туда каждый вечер."],[12.12,15.38,"Колмсанниларри спугнул его, наверное."],[17.59,19.42,"Что вы слышали о Колмсанниларри?"],[19.96,22.92,"Вы разве не были лучшими друзьями?"],[22.92,24.3,"Мы по-прежнему лучшие друзья."],[24.3,25.72,"- Нет.\n- Кто говорит, что нет?"],[25.72,26.8,"Она."],[26.8,28.26,"Ради бога, Шивон."],[28.26,31.52,"Я ничего подобного не говорила,\nмиссис Маккормик! Я просто болтала."],[31.52,34.77,"Иди к Джонджо, Падрик,\nи не путайся у нас под ногами."],[34.77,37.48,"Конечно, миссис Маккормик ведь\nникогда не удается прийти поболтать."],[37.48,39.06,"Никогда, ты же ее избегаешь."],[39.06,40.15,"Неправда!"],[40.15,42.65,"Ты прячешься за стеной,\nкогда она идет по дороге."],[43.53,45.07,"Я не..."],[45.7,47.66,"прячусь за стеной."],[59.88,61.25,"Удачи вам."]]}}