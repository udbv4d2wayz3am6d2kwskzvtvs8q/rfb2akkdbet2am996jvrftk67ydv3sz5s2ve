"],[0.7,5.37,"Okay, so sometimes when a new hire\nis adjusting to a severed space,"],[5.45,7.67,"we help by bringing them here\nto the stairwell,"],[7.75,9.63,"to experience the transition viscerally."],[9.71,11.59,"Oh, no. I'm trying to leave?"],[11.67,12.88,"No, no."],[12.96,14.42,"It's all part of the process."],[14.51,16.92,"If you wanna spin around\nand head back in, that should be that."],[21.8,22.8,"Hey, there."],[25.72,28.39,"-What the hell?\n-That's okay."],[29.23,30.23,"Not a problem."],[30.9,32.61,"Wanna give it another shot?"],[32.69,34.11,"Maybe with a little oomph?"],[39.45,40.28,"Hi."],[40.87,41.95,"I'm at the stairwell."],[43.2,44.74,"It's going fair."],[45.99,47.29,"No, she's--"],[47.37,48.37,"Fuck!"],[49.87,50.96,"I'ma call you back."],[53.21,54.21,"Wow."]],"ru":[[0,0.2,"Где это мы?"],[0.7,5.37,"Ну смотри, чтобы помочь новому сотруднику\nпривыкнуть к разделённому этажу,"],[5.45,7.67,"мы показываем эту лестницу,"],[7.75,9.63,"чтобы помочь акклиматизироваться."],[9.71,11.59,"О нет. Я хочу уйти."],[11.67,12.88,"Нет, нет."],[12.96,14.42,"Это часть обучения."],[14.51,16.92,"Можешь развернуться и зайти обратно."],[21.8,22.8,"Привет."],[25.72,28.39,"- Как так?\n- Ерунда."],[29.23,30.23,"Так бывает."],[30.9,32.61,"Давай ещё раз?"],[32.69,34.11,"Да посмелее."],[39.45,40.28,"Да."],[40.87,41.95,"Я на лестнице."],[43.2,44.74,"Всё в норме."],[45.99,47.29,"Нет, она…"],[47.37,48.37,"Твою мать!"],[49.87,50.96,"Ага. Я перезвоню."],[53.21,54.21,"Ого."]]}}