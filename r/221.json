{"n":221,"title":"Во все тяжкие","year":2008,"season":1,"episode":1,"path":"/k/404900/s1e1","posters":["https://st.kp.yandex.net/images/film_iphone/iphone360_404900.jpg","https://jbofvi6q36.a.trbcdn.net/prod/media/torrents/poster_mini/torrents/poster_mini/breakingbad-c75599800a3111f08b1eac1f6bb935e8-341x512_cx3GOgs.webp"],"ratings":{"kp":8.9,"imdb":9.5},"duration":68.342,"mediaStart":2.206,"frameRate":25,"videoLead":0.101333,"clockOrigin":2571.418667,"focus":[[0,0.5831,1],[10.8153,0.5808,1],[15.0953,0.4099,1],[18.0953,0.5785,1],[23.6153,0.4169,1],[26.5353,0.5831,1],[29.4953,0.4053,1],[30.7353,0.5659,1],[31.3187,0.5654,0],[31.5687,0.5633,0],[32.402,0.5377,0],[32.9853,0.5232,0],[33.652,0.5123,0],[34.2353,0.508,0],[34.5687,0.5093,0],[35.3187,0.5318,0],[35.5687,0.5363,0],[36.5687,0.5394,0],[38.8953,0.4561,1],[41.8153,0.5924,1],[43.4953,0.4469,1],[46.5753,0.5577,1],[53.4953,0.4815,1],[55.2153,0.5462,1],[56.5753,0.4792,1],[57.9353,0.2321,1],[58.4353,0.2326,0],[58.6853,0.2349,0],[58.9353,0.2409,0],[59.1853,0.2529,0],[59.352,0.2648,0],[59.602,0.2861,0],[60.6853,0.3863,0],[61.102,0.4228,0],[61.352,0.4395,0],[61.5187,0.4446,0],[62.602,0.4479,0]],"captions":{"en":[[0,1.51,"This is glass-grade."],[2.39,7.77,"You got... Jesus, you got crystals\nin here two inches, three inches long."],[7.98,9.56,"This is pure glass."],[11.32,13.48,"You're a goddamn artist."],[14.07,16.78,"This is art, Mr. White."],[17.32,19.37,"Well, actually,\nit's just basic chemistry..."],[19.57,22.33,"...but thank you, Jesse.\nI'm glad it's acceptable."],[22.53,25.29,"Acceptable?\nYou're the goddamn Iron Chef."],[25.58,28.25,"Every jibhead from here to Timbuktu's\ngonna want a taste."],[29.75,34.67,"- Man, I gotta try this.\n- No. No."],[35.26,37.63,"No. We only sell it. We don't use it."],[38.93,40.55,"Okay, since when?"],[41.43,43.89,"Listen, you've been watching\nway too much Miami Vice."],[44.1,45.31,"That ain't happening."],[49.4,52.23,"So, what now?"],[54.11,55.32,"How do we proceed?"],[59.49,61.62,"We cook more tomorrow."],[62.74,64.58,"Meantime..."],[65.04,67.37,"...I know just the guy to talk to."]],"ru":[[0,1.51,"Это же стекло."],[2.39,7.77,"У вас тут… Боже, тут кристаллы\nпо пять-семь сантиметров в длину."],[7.98,9.56,"Это прямо стекло!"],[11.32,13.48,"Вы художник, мать вашу."],[14.07,16.78,"Это искусство, мистер Уайт."],[17.32,19.37,"Вообще-то, это простые основы химии,"],[19.57,22.33,"но спасибо, Джесси.\nЯ рад, что неплохо вышло."],[22.53,25.29,"Неплохо? Вы, блин, Железный повар."],[25.58,28.25,"Все торчки отсюда\nдо Тимбукту захотят отведать."],[29.75,34.67,"- Надо самому попробовать.\n- Нет. Нет."],[35.26,37.63,"Нет. Мы только продаем,\nа не употребляем."],[38.93,40.55,"С каких это пор?"],[41.43,43.89,"Вы что, «Полицию Майами» пересмотрели?"],[44.1,45.31,"Не бывать такому."],[49.4,52.23,"Ладно, что теперь?"],[54.11,55.32,"Что будем делать?"],[59.49,61.62,"Завтра еще наварим."],[62.74,64.58,"А пока…"],[65.04,67.37,"Я знаю, с кем поговорить."]]}}