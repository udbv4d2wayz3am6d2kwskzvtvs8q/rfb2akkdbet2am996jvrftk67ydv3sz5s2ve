317,0.6478,0],[50.9983,0.6558,0],[51.165,0.6604,0],[51.3733,0.4191,1]],"captions":{"en":[[2,3.08,"Father Jefferson?"],[4,6.29,"Hello. Jud Duplenticy from Albany?"],[6.38,9.08,"Lord be with you,\nJud Duplenticy from Albany."],[12.21,14.33,"You here to take my church away from me?"],[15.67,17.46,"Oh. No."],[18.04,18.92,"Good."],[19.79,22.21,"Okay, call me Monsignor Wicks."],[23.13,24.42,"I see you've met Martha."],[25.29,26.54,"Martha? No."],[26.63,28.13,"-Monsignor Wicks.\n-Jesus!"],[28.21,30.71,"I woke up early to polish the silver."],[30.79,32.08,"It was a bit blotchy."],[32.17,33.71,"That'll be fine, Martha."],[33.79,36,"Father… Jud."],[37.29,38.58,"You are welcome here."],[39.08,40.71,"-Thank you, Martha.\n-Mm."],[40.79,43.42,"I was actually\njust saying to Father Wicks…"],[43.5,45.08,"Monsignor Wicks."],[45.92,47.79,"Monsignor, right. Sorry."],[48.29,49.92,"And sorry for saying \"Jesus\"."],[51.71,53.88,"Hoo. This is going great, I think."],[53.96,56.5,"-Bishop Langstrom sent you, huh?\n-Mm-hmm."],[57.38,58.46,"Langstrom."],[58.96,60.63,"I know him well."]],"ru":[[2,3.08,"Отец Джефферсон?"],[4,6.29,"Я – Джад Дюплентиси из Олбани."],[6.38,9.08,"Господь с тобой,\nДжад Дюплентиси из Олбани."],[12.21,14.33,"Пришел заграбастать мою церковь?"],[15.67,17.46,"А! Нет."],[18.04,18.92,"Класс."],[19.79,22.21,"Ладно, зови меня Монсеньор Уикс."],[23.13,24.42,"Вы уже знакомы с Мартой."],[25.29,26.54,"С Мартой? Нет."],[26.63,28.13,"Монсеньор Уикс."],[28.21,30.71,"Я встала пораньше и начистила серебро."],[30.79,32.08,"Оно потускнело."],[32.17,33.71,"Благодарю тебя, Марта."],[33.79,36,"Отец Джад…"],[37.29,38.58,"Добро пожаловать."],[39.08,40.71,"Спасибо, Марта."],[40.79,43.42,"Я как\nраз рассказывал Отцу Уиксу…"],[43.5,45.08,"Монсеньору Уиксу."],[45.92,47.79,"Монсеньор, точно, простите."],[48.29,49.92,"И простите, что упомянул господа."],[51.71,53.88,"Фух. Кажется, неплохо прошло."],[53.96,56.5,"Епископ Лангстром тебя прислал, да?"],[57.38,58.46,"Лангстром. Я его знаю.\nОн выбрал тебя и прислал сюда."],[58.96,60.63,"Лангстром. Я его знаю.\nОн выбрал тебя и прислал сюда."]]}}