7773,0.6877,0],[51.8607,0.7321,0],[51.944,0.7563,0],[52.0273,0.7661,0],[52.1107,0.7681,0],[55.8607,0.7631,0],[56.5273,0.7638,0],[56.944,0.767,0],[57.0273,0.7599,0],[57.1107,0.7377,0],[57.194,0.692,0],[57.2773,0.618,0],[57.3607,0.5174,0],[57.444,0.4043,0],[57.5273,0.3019,0],[57.6107,0.2317,0],[57.694,0.2229,0],[74.1107,0.2229,0],[74.194,0.2548,0],[74.3607,0.3793,0],[74.444,0.4265,0],[74.5273,0.4504,0],[74.6107,0.451,0],[74.694,0.4335,0],[74.8607,0.3806,0],[74.944,0.3592,0],[75.0273,0.3445,0],[75.1107,0.3364,0],[75.194,0.3331,0],[77.7773,0.3298,0]],"captions":{"en":[[1,3.08,"Funny. You're really funny."],[4.29,6.34,"What do you mean, I'm funny?"],[6.42,9.72,"It's funny, you know. It's a good story."],[9.8,11.51,"You're a funny guy."],[12.51,14.76,"You mean the way I talk? What?"],[15.6,18.31,"It's just, you know. You're just funny."],[19.39,21.81,"You know, the way\nyou tell the story and everything."],[21.89,24.27,"Funny how? What's funny about it?"],[25.19,27.73,"- Tommy, you got it all wrong.\n- Anthony."],[27.82,30.49,"He's a big boy. He knows what he said.\nWhat did you say?"],[30.57,31.86,"Funny, how?"],[34.37,36.58,"Just, you know. You're funny."],[37.04,38.91,"Let me understand this."],[39.16,41.21,"Maybe I'm a little fucked up."],[41.29,44.67,"But, I'm funny, how? Funny like a clown?\nI amuse you?"],[45.42,48.05,"I make you laugh?\nI'm here to fucking amuse you?"],[48.13,50.84,"What do you mean, funny?\nHow am I funny?"],[54.3,56.6,"You know, how you tell a story."],[56.85,60.6,"No, I don't know. You said it.\nHow do I know? You said I'm funny."],[60.81,64.23,"How the fuck am I funny?\nWhat the fuck is so funny about me?"],[64.36,66.15,"Tell me what's funny."],[71.82,73.74,"Get the fuck out of here, Tommy."],[73.82,76.99,"Motherfucker! I almost had him!"],[78.12,80.16,"You stuttering prick, you!"]],"ru":[[1,3.08,"Смешно. Ты очень смешной."],[4.29,6.34,"Значит, я смешон?"],[6.42,9.72,"Просто это забавно.\nХорошая история."],[9.8,11.51,"Ты забавный парень."],[12.51,14.76,"Я смешно говорю? Или что?"],[15.6,18.31,"Ну, знаешь... просто ты забавный."],[19.39,21.81,"Ты так рассказываешь."],[21.89,24.27,"Смешно? Что здесь смешного?"],[25.19,27.73,"- Томми, ты не так понял.\n- Энтони..."],[27.82,30.49,"он отвечает за свои слова."],[30.57,31.86,"Смешно, каково?"],[34.37,36.58,"Просто, ты... ты смешной."],[37.04,38.91,"Дай разобраться."],[39.16,41.21,"Я слегка психованный."],[41.29,44.67,"Но чтобы я был смешон? Клоун?\nЯ тебя забавляю?"],[45.42,48.05,"Ты надо мной смеешься?\nЯ, мать твою, тебя смешу?"],[48.13,50.84,"Что значит, \"смешной\"? Как это?"],[54.3,56.6,"Ты так рассказываешь."],[56.85,60.6,"Нет, я не знаю. Ты сказал,\nчто я смешной."],[60.81,64.23,"Как именно я смешон?\nЧто, хрен, смешно во мне?"],[64.36,66.15,"Отвечай, что смешного!"],[71.82,73.74,"Томми, ты меня разыгрываешь."],[73.82,76.99,"Я его почти поимел!"],[78.12,80.16,"Член ты хренов, вот ты кто!"]]}}