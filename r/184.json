4025,0],[34.891,0.3969,0],[39.141,0.3824,0],[39.3077,0.3835,0],[39.391,0.3891,0],[39.4743,0.4024,0],[39.5577,0.4253,0],[39.8077,0.5169,0],[39.891,0.5417,0],[39.9743,0.5607,0],[40.0577,0.5742,0],[40.141,0.5828,0],[40.2243,0.5876,0],[40.391,0.5906,0],[40.641,0.5913,0],[43.4743,0.4975,1],[48.3077,0.4975,0],[48.891,0.4989,0],[49.3077,0.502,0],[49.7243,0.5077,0],[51.391,0.5407,0],[52.141,0.5511,0],[52.641,0.5532,0],[55.5993,0.5694,1],[58.891,0.5528,1],[61.3077,0.4361,1],[64.7243,0.5694,1],[67.1827,0.4167,1],[70.891,0.4167,1],[73.6827,0.35,1],[77.016,0.4732,1],[77.5993,0.4804,0],[78.016,0.482,0],[78.3493,0.4791,0],[79.4327,0.4613,0],[79.766,0.4612,0],[79.9327,0.4663,0],[80.1827,0.4836,0],[80.516,0.5143,0],[81.766,0.6403,0],[82.266,0.6884,0],[82.516,0.7088,0],[82.6827,0.7176,0],[82.766,0.72,0],[83.1827,0.7218,0],[87.3077,0.6315,1],[88.891,0.6327,0],[89.0577,0.6363,0],[89.891,0.662,0],[90.2243,0.6683,0],[90.641,0.6731,0],[92.391,0.681,0],[93.0577,0.68,0],[93.2243,0.678,0],[93.391,0.6696,0],[93.4743,0.6612,0],[93.5577,0.6497,0],[93.8077,0.6077,0],[93.891,0.5963,0],[93.9743,0.5876,0],[94.141,0.5773,0],[94.391,0.5732,0],[95.4327,0.7111,1]],"captions":{"en":[[0,1.95,"Are you blushing, daffodil?"],[2.82,3.95,"SPIDER-MAN: I'm not blushing."],[5.91,8.7,"Goddamn it.\nI knew I should have brought a bigger gun."],[8.71,10,"SPIDER-MAN: That's a good idea,\n\"Bring a bigger gun.\""],[10,11.25,"What are you gonna do,\ntickle him to death?"],[11.25,12.67,"No. Look, change of plan."],[12.67,15.46,"First, we get this on the Hulk,\nthen we go after Jean."],[15.46,16.71,"I got one better."],[16.71,18.67,"That's the highest\ncasualty-producing threat."],[18.67,21.93,"You contain it. I go find the source.\nI take it down. You got it?"],[22.51,24.39,"SPIDER-MAN: Are you just trying\nto get out of fighting the Hulk?"],[26.01,27.6,"- I guess so.\n- SPIDER-MAN: Okay, whatever, dude."],[27.6,28.6,"I got this."],[29.18,30.6,"- Wait, no, Frank, Frank, Frank.\n- What?"],[30.98,32.31,"SPIDER-MAN: Do not kill her!"],[32.31,34.56,"Don't start with that soft serve bullshit."],[34.56,36.48,"You know something?\nI'm gonna do this, I'm gonna do it my way."],[36.48,38.94,"Just... just go, just go."],[38.94,41.24,"SPIDER-MAN: And don't get within 33 feet!\nEh..."],[41.24,42.49,"SPIDER-MAN: So frustrating."],[57.46,58.46,"Hey."],[62.97,64.34,"Whoa!"],[64.34,66.51,"This guy's got issues."],[67.89,70.89,"No. Oh, no."],[70.89,73.6,"No, not again. Oh, no."],[74.4,77.02,"SPIDER-MAN: Dr. Banner? Is that you?"],[77.02,80.19,"Spider-Man. What happened?"],[80.19,81.32,"Where am I?"],[81.32,83.24,"- SPIDER-MAN: Hey, hey, hey.\n- Did I do all this?"],[83.24,84.74,"- SPIDER-MAN: You...\n- Did I hurt anyone?"],[84.74,86.41,"SPIDER-MAN: It's not your fault.\nShe was in your mind."],[86.41,87.32,"You weren't in control."],[87.33,89.37,"- I lost my inhibitor.\n- SPIDER-MAN: Look here, here."],[89.37,91.7,"It's the only thing\nkeeping the monster inside."],[91.7,92.7,"SPIDER-MAN: It's okay.\nI got another one here."],[92.71,93.62,"I just need you to put this on."],[93.62,95.42,"- What is it?\n- SPIDER-MAN: It's universal."],[95.42,96.71,"It should work on you."]],"ru":[[0,1.95,"Ты что, засмущался, желторотик?"],[2.82,3.95,"Я не смущаюсь."],[5.91,8.7,"Вот же чёрт. Знал же,\nчто надо было брать пушку побольше."],[8.71,10,"Отличная идея, «взять пушку побольше»."],[10,11.25,"Что, защекочешь его до смерти?"],[11.25,12.67,"Нет. Слушай, план меняется."],[12.67,15.46,"Сначала закрепим это на Халка,\nпотом идём за Джин."],[15.46,16.71,"У меня идея получше."],[16.71,18.67,"Он цель с самым\nвысоким потенциалом потерь."],[18.67,21.93,"Твоя задача сдержать его. Я иду\nза источником. Разберусь с ней. Усёк?"],[22.51,24.39,"Ты же просто с Халком сражаться не хочешь?"],[26.01,27.6,"- Наверное.\n- Ладно, как скажешь, чувак."],[27.6,28.6,"Я сам им займусь."],[29.18,30.6,"- Погоди, нет, Фрэнк.\n- Чего?"],[30.98,32.31,"Не убивай её!"],[32.31,34.56,"Только не начинай."],[34.56,36.48,"Знаешь что?\nЯ сделаю это и сделаю по-своему."],[36.48,38.94,"Давай... иди, иди уже."],[38.94,41.24,"И не подходи ближе, чем на десять метров!"],[41.24,42.49,"Как же бесит."],[57.46,58.46,"Привет."],[64.34,66.51,"У него кукуха едет."],[67.89,70.89,"Нет. О нет."],[70.89,73.6,"Нет, только не снова. О нет."],[74.4,77.02,"Доктор Бэннер? Это вы?"],[77.02,80.19,"Человек-паук. Что произошло?"],[80.19,81.32,"Где я?"],[81.32,83.24,"- Эй.\n- Это всё моих рук дело?"],[83.24,84.74,"- Вы...\n- Я кого-нибудь ранил?"],[84.74,86.41,"Она была в вашем разуме."],[86.41,87.32,"Вы не контролировали себя."],[87.33,89.37,"- Я потерял ингибитор.\n- Смотрите сюда, вот."],[89.37,91.7,"Это единственное,\nчто держит монстра внутри."],[91.7,92.7,"Всё хорошо. У меня тут ещё один.\nПросто нацепите это."],[92.71,93.62,"Всё хорошо. У меня тут ещё один.\nПросто нацепите это."],[93.62,95.42,"- Что это?\n- Он универсальный."],[95.42,96.71,"Должен на вас работать."]]}}