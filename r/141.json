,[32.07,35.28,"Well, we clocked the T-Rex\nat 32 miles an hour."],[37.12,38.5,"T-Rex?"],[39.62,41.58,"You said you've got a T-Rex?"],[42.63,43.75,"Say again."],[44.92,46.3,"We have a T-Rex."],[48.17,50.34,"Put your head\nbetween your knees."],[50.8,52.01,"Dr. Grant,"],[52.47,54.43,"my dear Dr. Sattler,"],[54.8,58.02,"welcome to Jurassic Park."],[81.66,83.42,"They're moving in herds."],[85.67,87.25,"They do move in herds."],[95.35,96.93,"How did you do this?"],[99.72,101.06,"I'll show you."]],"ru":[[0.08,1.58,"Это теплокровные существа.\nОни не живут в болотах."],[1.67,3.79,"- У него одна только шея, 28 футов в длину?"],[3.88,5.3,"- Бронтозавр, 30 футов."],[5.38,6.42,"Тридцать футов."],[22.98,25.61,"Это место принесет нам\nнемыслимый успех и деньги."],[30.45,31.95,"Они быстро бегают?"],[32.07,35.28,"Ну, тиранозавр пробегает...\nза час 32 мили."],[37.12,38.5,"Т-Рекс?"],[39.62,41.58,"У вас и тиранозавры обитают?"],[42.63,43.75,"Повторите-ка еще раз."],[44.92,46.3,"Да, у нас есть тиранозавр."],[48.17,50.34,"Ниже пригнись."],[50.8,52.01,"Ниже пригнись.\nДоктор Грант, моя дорогая\nДоктор Сеттлер.."],[52.47,54.43,"Доктор Грант, моя дорогая\nДоктор Сеттлер.."],[54.8,58.02,"добро пожаловать в парк\nЮрского периода."],[81.66,83.42,"Они передвигаются стаями."],[85.67,87.25,"Не может быть."],[95.35,96.93,"Как вам удалось?"],[99.72,101.06,"Я покажу."]]}}