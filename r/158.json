0],[30.679,0.4278,0],[30.7623,0.4348,0],[30.8457,0.4484,0],[31.0957,0.5126,0],[31.179,0.5292,0],[31.2623,0.5405,0],[31.3457,0.5471,0],[31.5123,0.5513,0],[32.2623,0.5509,0],[32.429,0.5463,0],[32.929,0.5232,0],[33.179,0.5164,0],[34.179,0.5127,0],[35.429,0.513,0],[35.5957,0.5176,0],[35.8457,0.5333,0],[36.0123,0.538,0],[37.0957,0.5393,0],[37.179,0.5371,0],[37.2623,0.5315,0],[37.3457,0.522,0],[37.5123,0.498,0],[37.5957,0.4885,0],[37.679,0.4821,0],[37.7623,0.4786,0],[38.0123,0.4761,0],[38.929,0.4739,0],[39.0123,0.4752,0],[39.0957,0.4794,0],[39.179,0.4875,0],[39.429,0.5229,0],[39.5123,0.5315,0],[39.5957,0.537,0],[39.679,0.5397,0],[40.0957,0.5412,0],[41.0957,0.5387,0],[42.3457,0.5221,0],[42.8457,0.5191,0],[43.0957,0.5231,0],[43.7623,0.548,0],[43.929,0.5513,0],[44.0957,0.5521,0],[44.179,0.5506,0],[44.2623,0.5454,0],[44.3457,0.5352,0],[44.429,0.5192,0],[44.5123,0.4971,0],[44.5957,0.4696,0],[44.7623,0.4074,0],[44.8457,0.3807,0],[44.929,0.3611,0],[45.0123,0.3492,0],[45.0957,0.3437,0],[45.179,0.3422,0],[45.429,0.3431,0],[45.5957,0.3469,0],[45.7623,0.3561,0],[45.8457,0.363,0],[45.929,0.3714,0],[46.0957,0.3924,0],[46.679,0.4784,0],[46.8457,0.501,0],[46.929,0.5097,0],[47.0123,0.5153,0],[47.0957,0.5171,0],[47.179,0.5148,0],[47.2623,0.5086,0],[47.3457,0.4994,0],[47.5123,0.4756,0],[48.0123,0.3978,0],[48.179,0.374,0],[48.2623,0.3645,0],[48.3457,0.3575,0],[48.5123,0.351,0],[49.8457,0.3476,0],[50.3457,0.3511,0],[50.7623,0.358,0],[50.929,0.3628,0],[51.0957,0.3704,0],[51.2623,0.3818,0],[51.679,0.4194,0],[51.8457,0.425,0]],"captions":{"en":[[2,4.38,"And how is it, Siobhán,\nthat you was never married?"],[8.51,11.72,"It's none of your fecking business\nhow I was never fecking married."],[11.72,12.93,"How isn't it?"],[13.72,15.01,"How isn't it?"],[15.76,16.89,"Was you never wild?"],[17.81,20.52,"Wild? Was I never wild?"],[21.56,23.31,"I don't know\nwhat you're talkin' about, Dominic."],[23.31,25.61,"Wild, how? Angry?"],[25.61,27.44,"'Cause I'm gettin' angry now,\nI can tell ya!"],[27.44,28.98,"Not angry. Wild."],[28.98,30.74,"You just keep sayin' wild, Dominic!"],[30.74,32.74,"- Wild!\n- My brother told you, didn't he?"],[32.74,35.53,"That you'd be out in the road\nif you started talking stupid to me?"],[35.53,36.78,"He said creepy, not stupid."],[36.78,39.04,"Well, you've failed on both counts,\nhaven't ya?"],[39.04,40.12,"I have."],[42.5,44.58,"I'm off to bed and he's not stayin' here\nanother night, Pádraic."],[44.58,48.13,"I don't care how depressed you are.\nI'd rather have the donkey in."],[53.38,54.84,"Foiled again."]],"ru":[[2,4.38,"Как вышло, что ты не замужем, Шивон?"],[8.51,11.72,"Не твое собачье дело."],[11.72,12.93,"Как так?"],[13.72,15.01,"Как так?"],[15.76,16.89,"Ты не пускалась во все тяжкие?"],[17.81,20.52,"Во все тяжкие? Я?"],[21.56,23.31,"Я не понимаю, о чём ты, Доминик."],[23.31,25.61,"Как - во все тяжкие? Ты о гневе?"],[25.61,27.44,"Ведь сейчас я в гневе, это точно!"],[27.44,28.98,"Я не про гнев. Я про все тяжкие."],[28.98,30.74,"Ты всё повторяешь это, Доминик!"],[30.74,32.74,"- Во все тяжкие!\n- Брат предупредил тебя, да?"],[32.74,35.53,"Что мы тебя выгоним,\nесли ты начнешь нести чушь?"],[35.53,36.78,"Он сказал про жуть, а не чушь."],[36.78,39.04,"Ну, ты нес и то и другое."],[39.04,40.12,"Да."],[42.5,44.58,"Я иду спать. Он здесь\nеще на ночь не останется, Падрик."],[44.58,48.13,"Мне плевать, насколько тебе грустно.\nПусть лучше ослица в доме ночует."],[53.38,54.84,"Меня снова отшили."]]}}