,[52.2067,0.4817,0],[52.6233,0.4795,0],[52.9567,0.4753,0],[53.1233,0.4711,0],[53.29,0.4635,0],[53.4567,0.452,0],[53.9567,0.4114,0],[54.1233,0.4008,0],[54.29,0.3951,0],[54.4567,0.394,0],[55.1233,0.3993,0],[56.7067,0.423,0],[57.8733,0.4372,0],[60.7067,0.4601,0],[61.6233,0.4692,0],[62.7067,0.4831,0],[65.3733,0.5215,0],[66.6233,0.5337,0],[67.29,0.5355,0]],"captions":{"en":[[2,3.46,"Listen, asshole!"],[3.54,5.13,"No, you listen, you little bitch!"],[5.21,8.42,"You hang up on me again,\nI'll gut you like a fish, understand?"],[10.76,12.13,"Yeah."],[12.22,14.05,"ls this some kind ofjoke?"],[14.14,16.47,"More ofa game, really."],[18.68,20.18,"Can you handle that..."],[22.14,23.73,"blondie?"],[34.7,36.37,"Can you see me?"],[38.83,43.46,"Listen, l am two seconds away\nfrom calling the police."],[43.54,47.96,"They'd never make it in time.\nWe're out in the middle ofnowhere."],[48.05,52.97,"- What do you want?\n- To see what your insides look like."],[60.6,64.77,"Who's there? Who's there?"],[65.77,67.27,"l'm calling the police."],[70.4,72.19,"You should never say, \"Who's there?\""],[72.28,75.74,"Don't you watch scary movies?\nIt's a death wish."],[75.82,79.28,"You might as welljust come out here\nto investigate a strange noise or something."]],"ru":[[2,3.46,"Слушай, козел!"],[3.54,5.13,"Hет, это ты меня послушай,\nмаленькая дрянь!"],[5.21,8.42,"Еще раз бросишь трубку, и я\nвыпотрошу тебя, как рыбу. Поняла?"],[10.76,12.13,"Да."],[12.22,14.05,"Это что, шутка какая-то?"],[14.14,16.47,"Скорее игра."],[18.68,20.18,"Hу что, поиграем?"],[22.14,23.73,"Блондиночка."],[34.7,36.37,"Ты меня видишь?"],[38.83,43.46,"Слушай... я сейчас вызову полицию."],[43.54,47.96,"Им ни за что не добраться\nвовремя в это захолустье."],[48.05,52.97,"Чего ты хочешь?\nПолюбоваться на твои внутренности."],[60.6,64.77,"Кто там?"],[65.77,67.27,"Я звоню в полицию!"],[70.4,72.19,"Hикогда не спрашивай : кто там?"],[72.28,75.74,"Ты же смотришь ужасы?\nЭто желание смерти..."],[75.82,79.28,"Еще бы вышла и проверила,\nчто тут за странные звуки."]]}}