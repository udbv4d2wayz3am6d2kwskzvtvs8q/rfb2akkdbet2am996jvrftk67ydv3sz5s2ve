],[38.9213,0.3892,0],[39.0047,0.4091,0],[39.088,0.4221,0],[39.1713,0.4292,0],[39.2547,0.4324,0],[39.9213,0.4345,0],[41.338,0.434,0],[43.0047,0.4308,0],[43.5047,0.4274,0],[43.7547,0.4235,0],[44.088,0.4148,0],[45.588,0.361,0],[45.6713,0.3591,0],[45.7547,0.3598,0],[45.838,0.3661,0],[45.9213,0.379,0],[46.0047,0.3981,0],[46.088,0.4225,0],[46.1713,0.4508,0],[46.2547,0.4818,0],[46.7547,0.6756,0],[46.838,0.7052,0],[46.9213,0.7313,0],[47.0047,0.7528,0],[47.088,0.7687,0],[47.1713,0.7788,0],[47.2547,0.7833,0],[53.9213,0.7833,0],[54.588,0.7728,0],[56.338,0.7342,0],[56.838,0.7264,0],[57.2547,0.7222,0],[57.6713,0.7202,0],[58.088,0.721,0],[59.7547,0.7344,0],[60.588,0.7345,0],[60.7547,0.7328,0],[60.838,0.7279,0],[60.9213,0.7166,0],[61.0047,0.6963,0],[61.088,0.665,0],[61.1713,0.6224,0],[61.338,0.5191,0],[61.4213,0.4734,0],[61.5047,0.4389,0],[61.588,0.4162,0],[61.6713,0.4036,0],[61.7547,0.3982,0],[61.838,0.3967,0],[63.463,0.4788,1],[68.9213,0.2757,1],[74.6297,0.4504,1]],"captions":{"en":[[2,3.96,"I don't think I should drive."],[4.21,6.09,"I don't either."],[6.34,7.71,"Watch your head."],[7.92,11.09,"Watch your knees.\nDon't break anything."],[11.34,13.47,"Let's not forget seat belts."],[15.43,18.56,"Who else could go for some\nflapjacks right now?"],[23.81,25.52,"Let me ask you a question."],[25.77,26.82,"Shoot."],[28.15,30.15,"What if there were no tomorrow?"],[30.7,33.99,"No tomorrow? That means there'd be\nno consequences..."],[34.24,35.78,"...no hangovers."],[36.03,38.49,"We could do whatever we wanted!"],[39.91,41.29,"That's true."],[41.5,44.63,"We could do whatever we want."],[50.22,53.76,"If we wanted to hit mailboxes,\nwe could let Ralph drive!"],[60.56,62.14,"They want you to stop."],[62.31,63.35,"Hang on!"],[69.03,71.03,"It's the same thing\nyour whole life."],[71.49,74.41,"\"Clean up your room! Stand up\nstraight! Pick up your feet!"],[74.86,76.41,"Take it like a man!"],[76.62,78.28,"Be nice to your sister!"],[79.12,81.62,"Don't mix beer and wine, ever!"]],"ru":[[2,3.96,"Мне лучше не садиться за руль."],[4.21,6.09,"Я согласен."],[6.34,7.71,"Головой не ударься."],[7.92,11.09,"И коленками тоже.\nНе сломай чего-нибудь."],[11.34,13.47,"И не забудьте пристегнуться."],[15.43,18.56,"Кто-нибудь хочет немного блинчиков?"],[23.81,25.52,"У меня есть вопрос."],[25.77,26.82,"Давай."],[28.15,30.15,"Представьте, что завтра не наступит."],[30.7,33.99,"Не наступит? Значит, можно\nне бояться последствий..."],[34.24,35.78,"не будет похмелья."],[36.03,38.49,"Мы делали бы все, что угодно!"],[39.91,41.29,"Это верно."],[41.5,44.63,"Делали бы все, что угодно."],[50.22,53.76,"Если бы мы хотели сбивать почтовые ящики,\nможно было бы и Ральфа за руль посадить."],[60.56,62.14,"Они хотят, чтобы ты остановился."],[62.31,63.35,"Держитесь."],[69.03,71.03,"Всю жизнь нас учат одному и тому же."],[71.49,74.41,"Убирай свою комнату! Не сутулься!\nНе шаркай ногами!"],[74.86,76.41,"Будь мужчиной!"],[76.62,78.28,"Не хами сестре!"],[79.12,81.62,"Никогда не мешай пиво с вином!"]]}}