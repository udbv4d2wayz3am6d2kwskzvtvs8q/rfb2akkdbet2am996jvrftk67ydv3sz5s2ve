{"n":225,"title":"Офис","year":2005,"season":2,"episode":1,"path":"/k/253245/s2e1","posters":["https://st.kp.yandex.net/images/film_iphone/iphone360_253245.jpg","https://jbofvi6q36.a.trbcdn.net/prod/media/torrents/poster_mini/torrents/poster_mini/theoffice-08818f70dead11ed8f5e3cecef228558-341x512.webp"],"ratings":{"kp":8.7,"imdb":9},"duration":88.474,"mediaStart":2,"frameRate":25,"videoLead":0.117333,"clockOrigin":37.402667,"focus":[[0,0.3938,1],[2.0373,0.5901,1],[15.3573,0.4446,1],[16.2373,0.3799,1],[19.1973,0.6155,1],[42.6773,0.7771,1],[45.6773,0.7771,0],[45.7607,0.7659,0],[45.844,0.7361,0],[45.9273,0.6901,0],[46.094,0.5828,0],[46.1773,0.539,0],[46.2607,0.5071,0],[46.344,0.4868,0],[46.4273,0.4759,0],[46.5107,0.4714,0],[46.594,0.4702,0],[48.3173,0.6362,1],[59.7173,0.5241,1],[62.0507,0.5196,0],[62.2173,0.5176,0],[62.3007,0.5128,0],[62.384,0.5036,0],[62.4673,0.4899,0],[62.7173,0.4348,0],[62.884,0.4012,0],[63.0507,0.3758,0],[63.2173,0.3582,0],[63.384,0.3469,0],[63.634,0.337,0],[63.9673,0.328,0],[64.384,0.3197,0],[65.384,0.3087,0],[68.3007,0.2929,0],[71.3007,0.2691,0],[71.884,0.2675,0],[74.8007,0.2689,0],[74.884,0.2703,0],[74.9673,0.2759,0],[75.0507,0.2888,0],[75.134,0.3122,0],[75.2173,0.3478,0],[75.3007,0.3952,0],[75.384,0.4516,0],[75.4673,0.5108,0],[75.5507,0.5641,0],[75.634,0.6034,0],[75.7173,0.6272,0],[75.8007,0.6385,0],[75.884,0.6419,0],[75.9673,0.6419,0],[78.5573,0.6215,1],[79.1407,0.6236,0],[79.8907,0.6305,0],[79.974,0.6264,0],[80.0573,0.6124,0],[80.1407,0.5832,0],[80.224,0.5359,0],[80.3073,0.4712,0],[80.3907,0.3969,0],[80.474,0.326,0],[80.5573,0.2719,0],[80.6407,0.239,0],[80.724,0.2254,0],[80.974,0.2239,0],[87.3573,0.2229,1]],"captions":{"ru":[[0.35,1.55,"Сегодня мы вручаем «Данди» —"],[1.62,4.49,"ежегодную награду для\nсотрудников."],[4.56,7.75,"Это самый любимый всеми день."],[8.36,10.02,"Его ждут с нетерпением."],[10.1,12.22,"Понимаете, для некоторых\nвозможность"],[12.3,16.23,"получить приз выпадает не часто.\nНапример, Мередит или Кевину."],[16.3,18.79,"Ну кто станет награждать Кевина?\nПродавцы пончиков?"],[18.87,21.6,"Да и церемония добавляет\nв жизнь радости."],[21.67,24.27,"Вот представьте, приходит\nсотрудник домой"],[24.34,26.71,"и спрашивает у соседа: «А ты\nполучал на работе призы?»"],[26.78,30.08,"А тот ему: «Не, чувак, я пашу,\nкак на галерах,"],[30.15,31.52,"и никакой благодарности»."],[31.58,34.52,"Оглянуться не успеешь,"],[34.59,36.52,"а сосед-то уже ласты склеил."],[36.72,40.39,"Повесился, например. И всё\nот недостатка признания."],[42.33,45.23,"Ну как, готова к Данди?"],[46.4,47.89,"Говорят, когда видишь\nаварию,"],[47.97,50.73,"то вам так страшно, что даже\nвзгляд не отвести."],[50.97,54.8,"Вот и с Данди та же история.\nВам хочется отвернуться,"],[54.87,58.64,"но приходится смотреть, поскольку\nтак приказал начальник."],[58.84,62.34,"Хо-хо-хо! Толстяк Халперт!"],[64.72,68.59,"Что?\nТолстяк Халперт. Джим Халперт."],[71.56,75.19,"Позвольте вам представить\nлауреатов прошлых лет."],[75.26,78.03,"Вот это «Толстяк» Джим\nХалперт."],[78.1,80.53,"Джим, покажи статуэтки\nна камеру."],[80.6,82.26,"Не могу, я их спрятал."],[82.34,84.56,"Если будут перед глазами —\nещё возгоржусь."],[84.64,86.07,"О, это разумно."],[86.14,88.4,"А мои стоят дома на полке\nу кровати."]]}}