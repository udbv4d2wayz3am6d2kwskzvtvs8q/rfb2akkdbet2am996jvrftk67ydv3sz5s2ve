434,0.6133,0],[76.5173,0.6654,0],[76.6007,0.7013,0],[76.684,0.7226,0],[76.7673,0.7329,0],[76.8507,0.7362,0],[76.934,0.7365,0],[83.3507,0.7356,0],[83.434,0.7312,0],[83.5173,0.7193,0],[83.6007,0.6956,0],[83.684,0.6572,0],[83.7673,0.6029,0],[83.8507,0.5354,0],[83.934,0.4643,0],[84.0173,0.4003,0],[84.1007,0.353,0],[84.184,0.3236,0],[84.2673,0.3091,0],[84.3507,0.3044,0],[84.434,0.3042,0],[87.3507,0.31,0],[87.8507,0.3053,0],[88.7673,0.29,0],[88.8507,0.2937,0],[88.934,0.3074,0],[89.0173,0.3371,0],[89.1007,0.3865,0],[89.184,0.4542,0],[89.2673,0.5293,0],[89.3507,0.5994,0],[89.434,0.654,0],[89.5173,0.6909,0],[89.6007,0.7118,0],[89.684,0.721,0],[89.7673,0.7235,0],[92.6007,0.7215,0],[92.684,0.7168,0],[92.7673,0.7044,0],[92.8507,0.68,0],[92.934,0.6406,0],[93.0173,0.585,0],[93.1007,0.5157,0],[93.184,0.4422,0],[93.2673,0.3742,0],[93.3507,0.3203,0],[93.434,0.2827,0],[93.5173,0.2599,0],[93.6007,0.2486,0],[93.684,0.2447,0],[95.3507,0.2451,0],[95.434,0.2495,0],[95.5173,0.2614,0],[95.6007,0.285,0],[95.684,0.3233,0],[95.7673,0.3777,0],[95.8507,0.446,0],[95.934,0.5198,0],[96.0173,0.589,0],[96.1007,0.6447,0],[96.184,0.6841,0],[96.2673,0.7085,0],[96.3507,0.7211,0],[96.434,0.7257,0],[96.5173,0.7266,0],[99.684,0.7268,0],[99.7673,0.7258,0],[99.8507,0.7206,0],[99.934,0.7072,0],[100.0173,0.6815,0],[100.1007,0.6406,0],[100.184,0.584,0],[100.3507,0.4451,0],[100.434,0.384,0],[100.5173,0.3397,0],[100.6007,0.3129,0],[100.684,0.3001,0],[100.7673,0.2962,0],[100.8507,0.2961,0]],"captions":{"en":[[0.37,3.41,"What do you say\nI buy you a cup of coffee?"],[9.54,12.84,"— Yeah, sure. Let's go.\n— Follow me."],[28.61,31.07,"Seven years in Folsom."],[31.23,33.07,"In the hole for three."],[33.24,34.53,"McNeil before that."],[38.11,40.45,"McNeil as tough as they say?"],[41.33,43.2,"You looking to become a penologist?"],[44.45,47.58,"You're looking to go back?\nYou know, I chase down some crews…"],[47.75,52.17,"…guys just looking to fuck up,\nget busted back. That you?"],[52.88,55.09,"You must've worked some dipshit crews."],[55.88,58.09,"I worked all kinds."],[61.1,63.64,"You see me doing thrill-seeking\nliquor-store holdups…"],[63.81,66.14,"…with a «Born to Lose» tattoo\non my chest?"],[66.31,69.14,"— No, I do not.\n— Right."],[70.31,72.15,"I am never going back."],[73.78,76.03,"Then don't take down scores."],[77.2,79.82,"I do what I do best, I take scores."],[79.99,83.62,"You do what you do best,\ntrying to stop guys like me."],[86.83,89.67,"So you never wanted a regular-type life?"],[89.83,92.84,"What the fuck is that?\nBarbecues and ball games?"],[94.59,95.71,"Yeah."],[98.17,102.79,"— This regular-type life like your life?\n— My life? No, my life…"]],"ru":[[0.37,3.41,"Могу я угостить тебя кофе?"],[9.54,12.84,"— Хорошо, пошли.\n— Давай за мной."],[28.61,31.07,"7 лет в Фолсоме. В норе на троих."],[33.24,34.53,"Раньше тебя звали Мак Нил."],[38.11,40.45,"Мак Нил действительно\nкрутой, как говорят?"],[41.33,43.2,"А ты записался в фенологи?"],[44.45,47.58,"Хочешь туда вернуться?"],[47.75,52.17,"Были на моей памяти парни, которые\nсами в тюрьму просились.\nА ты?"],[52.88,55.09,"Дерьмовые парни были."],[55.88,58.09,"Всякие были."],[61.1,63.64,"Ты представляешь, чтобы я\nс наколкой «Рожденный проиграть»…"],[63.81,66.14,"…брал магазин со спиртным?"],[66.31,69.14,"— Не представляю.\n— Правильно."],[70.31,72.15,"Я никогда туда не вернусь."],[73.78,76.03,"Тогда бросай свои дела."],[77.2,79.82,"Я делаю, что умею."],[79.99,83.62,"И ты делаешь, что умеешь —\nпытаешься остановить таких, как я."],[86.83,89.67,"Тебе никогда не хотелось\nнормальной жизни?"],[89.83,92.84,"А что это: пикники, игра в мяч?"],[94.59,95.71,"Да."],[98.17,102.79,"— И такая нормальная жизнь по тебе?\n— По мне, нет."]]}}