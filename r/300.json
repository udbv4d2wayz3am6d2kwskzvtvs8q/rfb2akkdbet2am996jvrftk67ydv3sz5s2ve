],[40.264,0.3961,0],[40.3473,0.3931,0],[40.4307,0.4029,0],[40.514,0.4214,0],[40.5973,0.4425,0],[40.6807,0.4571,0],[40.764,0.4567,0],[40.8473,0.4401,0],[41.014,0.3881,0],[41.0973,0.3641,0],[41.1807,0.3438,0],[41.264,0.3273,0],[41.4307,0.3016,0],[41.9307,0.2344,0],[42.0973,0.2148,0],[42.1807,0.2125,0],[42.5973,0.2125,0],[42.6807,0.2223,0],[42.764,0.264,0],[42.8473,0.3359,0],[43.014,0.5238,0],[43.0973,0.6029,0],[43.1807,0.6594,0],[43.264,0.6931,0],[43.3473,0.708,0],[43.4307,0.7101,0],[43.514,0.7054,0],[43.5973,0.6974,0],[44.1807,0.6259,0],[44.764,0.5468,0],[45.014,0.5071,0],[45.1807,0.4763,0],[45.3473,0.4413,0],[45.8473,0.3285,0],[45.9307,0.3133,0],[46.014,0.3022,0],[46.0973,0.2963,0],[46.1807,0.2965,0],[46.264,0.3032,0],[46.3473,0.3159,0],[46.4307,0.3337,0],[46.5973,0.3792,0],[47.014,0.5059,0],[47.1807,0.5544,0],[47.264,0.5755,0],[47.3473,0.5931,0],[47.4307,0.6064,0],[47.514,0.6155,0],[47.5973,0.6209,0],[47.6807,0.6237,0],[47.8473,0.6252,0]],"captions":{"en":[[0.78,4.62,"- Sir, are you making that up?\n- No. It's in the field manual."],[4.74,6.58,"You check it out if you want to."],[6.66,8.75,"We seem to be out of field manuals, sir."],[8.83,10.75,"Perhaps you can enlighten us?"],[10.83,12.29,"All right, you have\nsome demolition, don't you?"],[12.42,14.34,"Some TNT or some composition B?"],[14.42,16.13,"Yeah, that, sir, is the one thing\nwe got plenty of."],[16.25,18.88,"I got that bridge wired with enough\ncomposition B to blow it twice."],[18.96,20.97,"All right. You can spare some, then."],[21.09,24.3,"You take a standard-issue Gl sock,"],[24.43,27.52,"cram it with as much\ncomp B as it can hold,"],[27.6,30.06,"rig up a simple fuse,"],[30.14,32.69,"then you coat the whole thing\nwith axle grease."],[32.77,37.27,"That way, when you throw it,\nit should stick. It's a bomb that sticks."],[37.36,38.98,"It's a sticky bomb."],[39.11,41.49,"You come up with a better way\nto knock the tracks off a tank,"],[41.61,43.2,"I'm all ears."],[43.28,46.83,"This is good.\nNow we got to surrender our socks."]],"ru":[[0.78,4.62,"Это вы только что придумали, сэр?\nНет. Это есть в боевом уставе."],[4.74,6.58,"Если хотите, можете посмотреть."],[6.66,8.75,"Кажется, у нас нет\nбоевых уставов, сэр."],[8.83,10.75,"Может быть, вы нас просветите."],[10.83,12.29,"Хорошо, у вас ведь есть взрывчатка?"],[12.42,14.34,"Например, динамит или смесь\"Б\"?"],[14.42,16.13,"Этого добра у нас хватает."],[16.25,18.88,"Под мостом у нас заложена смесь \"Б\",\nеё хватит, чтобы мост\nдважды взорвать."],[18.96,20.97,"Тогда можно её взять."],[21.09,24.3,"Берётся обычный носок,"],[24.43,27.52,"плотно набивается смесью \"Б\","],[27.6,30.06,"приделывается фитиль,"],[30.14,32.69,"затем всё это смазывается дёгтем."],[32.77,37.27,"И когда бросаешь её,\nона должна прилипнуть."],[37.36,38.98,"Это бомба, которая прилипает.\n\"Бомба-липучка\"."],[39.11,41.49,"Лучшего способа не придумаешь -\nвзорвать гусеницы танка"],[41.61,43.2,"Я весь внимание."],[43.28,46.83,"Это хорошо.\nПридётся, правда, пожертвовать носками."]]}}