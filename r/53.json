{"n":53,"title":"Марсианин","year":2015,"season":0,"episode":0,"path":"/k/841700","posters":["https://jbofvi6q36.a.trbcdn.net/prod/media/torrents/poster_mini/torrents/poster_mini/themartian-1b3aecca8e7f11eda6393cecef228558-341x512.webp","https://st.kp.yandex.net/images/film_iphone/iphone360_841700.jpg"],"ratings":{"kp":7.8,"imdb":8},"duration":43.384,"mediaStart":4.867,"frameRate":24,"videoLead":0.112,"clockOrigin":311.413,"focus":[[0,0.5115,1],[2.1617,0.5115,1],[3.245,0.3222,1],[9.37,0.3222,1],[9.8283,0.3337,1],[20.7033,0.3337,1],[20.745,0.3337,1],[22.4117,0.3337,1],[23.8283,0.7021,1],[24.6617,0.7019,0],[24.9117,0.7,0],[25.3283,0.6904,0],[26.495,0.6568,0],[27.0783,0.6459,0],[31.3283,0.6396,0],[32.6617,0.6345,0],[33.1617,0.6307,0],[33.495,0.626,0],[33.745,0.619,0],[34.3283,0.5864,0],[34.495,0.5803,0],[36.0783,0.5741,0],[36.1617,0.5712,0],[36.245,0.5654,0],[36.3283,0.5557,0],[36.4117,0.5413,0],[36.495,0.5224,0],[36.6617,0.4768,0],[36.745,0.456,0],[36.8283,0.4412,0],[36.9117,0.4334,0],[36.995,0.4319,0],[37.0783,0.4342,0],[37.495,0.4577,0],[37.5783,0.4611,0],[37.745,0.4626,0],[37.8283,0.46,0],[37.9117,0.4546,0],[38.3283,0.4142,0],[38.6617,0.3912,0],[38.745,0.381,0],[38.8283,0.3645,0],[38.9117,0.3412,0],[39.0783,0.2869,0],[39.1617,0.2625,0],[39.245,0.2429,0],[39.3283,0.2297,0],[39.4117,0.2232,0]],"captions":{"en":[[2,5.04,"Commander, we're at 10 degrees,\nand the MAV is gonna tip at 12.3."],[5.52,8.84,"Hey! We might be able to keep\nthe MAV from tipping."],[8.94,10,"How?"],[10.1,12.99,"Use the cables from the comms\nmast as guy-lines,"],[13.09,16.04,"- anchor it with the Rover's.\n- Watch out!"],[19.18,20.93,"Watney!"],[21.83,24.13,"Warning. Suit breach detected."],[24.23,25.79,"- What happened?\n- He was hit."],[25.88,27.07,"Watney, report."],[27.17,29.87,"Before we lost telemetry,\nhis decompression alarm went off."],[29.96,32.35,"- Where did you last see him?\n- I don't know where he is."],[32.45,34.41,"- What are the vitals on his suit?\n- He's offline."],[34.49,35.91,"A complete loss of signal on Watney."],[35.93,37.02,"- Beck!\n- Yeah."],[37.12,40.81,"- How long can he survive decompression?\n- Less than a minute."],[41.05,43.29,"Line up, walk west."]],"ru":[[2,5.04,"Командир, наклон 10 градусов,\nвзлетный модуль упадет при 12,3."],[5.52,8.84,"Слушайте! Можно попробовать\nпредотвратить его падение."],[8.94,10,"Как?"],[10.1,12.99,"Натянуть кабели мачты связи"],[13.09,16.04,"и прикрепить их к вездеходам.\nБерегись!"],[19.18,20.93,"Уотни!"],[21.83,24.13,"Тревога. Повреждение скафандра."],[24.23,25.79,"Что случилось?\n- Его ударило."],[25.88,27.07,"- Уотни, отвечай."],[27.17,29.87,"До потери телеметрии\nбыл сигнал о разгерметизации."],[29.96,32.35,"- Где ты его видела в последний раз?\n- Не знаю, где он."],[32.45,34.41,"- Его жизненные показатели?\n- Сигнала нет."],[34.49,35.91,"Полная потеря сигнала от Уотни."],[35.93,37.02,"- Бек!\n- Да."],[37.12,40.81,"Сколько он протянет\nпри разгерметизации?\nМеньше минуты."],[41.05,43.29,"Выстроиться в ряд, идем на запад."]]}}