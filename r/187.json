{"n":187,"title":"Киберпанк: Бегущие по краю","year":2022,"season":2,"episode":1,"path":"/k/2000102/s2e1","posters":["https://st.kp.yandex.net/images/film_iphone/iphone360_2000102.jpg","https://jbofvi6q36.a.trbcdn.net/prod/media/torrents/poster_mini/cyberpunkedgerunners-00a57ef6d12011f1b3ccac1f6b4de070_341x512_IbPVn8A.webp"],"ratings":{"kp":7.9,"imdb":8.3},"duration":57.831,"mediaStart":0.967,"frameRate":24,"videoLead":0,"clockOrigin":881.4,"focus":[[0,0.5,1],[2.408,0.6247,1],[6.658,0.6247,1],[9.533,0.4561,1],[13.533,0.5416,1],[17.408,0.5416,1],[18.4913,0.5416,1],[18.5747,0.5416,1],[19.158,0.5139,1],[23.0747,0.7771,1],[26.0747,0.7771,1],[26.7413,0.7771,1],[26.8663,0.2899,1],[28.6997,0.5046,1],[38.9497,0.5046,1],[39.0747,0.5046,1],[39.1997,0.5854,1],[39.4913,0.5854,1],[39.9497,0.5854,1],[40.408,0.5854,1],[41.3247,0.5854,1],[42.0747,0.5854,1],[42.8247,0.5854,1],[43.4497,0.5854,1],[44.283,0.5854,1],[44.908,0.5854,1],[45.283,0.5231,1],[47.783,0.5346,1],[55.033,0.5185,1],[57.783,0.5185,1]],"captions":{"en":[[0,0.7,"No shit?"],[0.7,2.41,"Tell me straight, Meshuga."],[2.41,3.7,"What happened back then?"],[3.7,5.25,"You should've died."],[5.25,6.66,"- Uh...\n- Oi."],[6.67,9.54,"You fucking snapped, is what happened."],[9.54,12.34,"If you didn't go psycho,\nthen Emily would still be..."],[13.55,15.71,"- Miguel--\n- Don't touch me."],[16.55,18.13,"Choomba, hear me out."],[19.18,21.22,"Don't touch me, I said."],[23.68,25.43,"Miggy, it ain't his fault."],[25.43,27.52,"- He never meant to... Miggy!\n- Let me go!"],[27.52,31.06,"I can't remember! Memory's fragged."],[31.06,33.82,"That day... Emily..."],[33.82,36.44,"- What happened?\n- You fucking killed her!"],[36.44,38.95,"- I what?\n- Why?"],[38.95,43.45,"Why'd we have to put her in the ground,\nwhile your gonk ass gets to live?"],[43.45,45.28,"You should've died there with her!"],[45.29,47.71,"What kinda edgerunner are you?"],[50.63,53.25,"Meshuga..."],[53.25,54.96,"Oughtta bounce, choom."],[55.55,56.8,"Talk soon, eh?"]],"ru":[[0,0.7,"Реально?"],[0.7,2.41,"Скажи, Мешуга."],[2.41,3.7,"Что тогда произошло…"],[3.7,5.25,"Ты должен был умереть."],[5.25,6.66,"Эй."],[6.67,9.54,"Ты сорвался, сука, вот что произошло."],[9.54,12.34,"Не слети у тебя тогда крыша,\nЭмили была бы…"],[13.55,15.71,"- Мигель…\n- Не трогай."],[16.55,18.13,"Мигель, я…"],[19.18,21.22,"Не трогай меня, сука, я сказал."],[23.68,25.43,"Эй, стой, Мигель! Кинг не виноват…"],[25.43,27.52,"- Отпусти!\n- Мигель!"],[27.52,31.06,"Расскажи! Я ничего не помню."],[31.06,33.82,"Что я сделал? Эмили…"],[33.82,36.44,"Ты ее убил!"],[36.44,38.95,"Я?\nПочему…"],[38.95,43.45,"Почему Эмили мертва, а ты, тупица, жив?"],[43.45,45.28,"Ты должен был сдохнуть там с ней!"],[45.29,47.71,"Что ты за киберпанк такой?"],[50.63,53.25,"Мешуга…"],[53.25,54.96,"Тебе лучше уйти."],[55.55,56.8,"Я с тобой свяжусь."]]}}