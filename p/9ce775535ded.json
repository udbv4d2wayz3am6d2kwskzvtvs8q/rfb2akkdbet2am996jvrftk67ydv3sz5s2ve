ptions":{"en":[[0.7,2.7,"Ta-da!"],[3.41,4.41,"You like it?"],[6.7,7.87,"You're lucky."],[7.95,11.32,"I didn't get to do much of this\nwith my older sis."],[11.87,13.28,"She was more into..."],[14.41,15.87,"hitting things."],[17.99,20.78,"I had a different name back then,\nyou know."],[22.07,23.16,"Powder."],[23.99,25.12,"Stupid, right?"],[25.95,28.37,"I thought I was rid of her\nfor good, but, uh..."],[29.37,31.28,"you kind of remind me of her."],[34.41,35.41,"Pew."],[42.45,44.87,"Did Sevika put you up to this?"]],"ru":[[0.7,2.7,"Та-да."],[3.41,4.41,"Тебе нравится?"],[6.7,7.87,"Тебе повезло."],[7.95,11.32,"Я не часто занималась этим\nсо своей старшей сестрой."],[11.87,13.28,"Она больше любила…"],[14.41,15.87,"…наносить удары."],[17.99,20.78,"Тогда у меня было другое имя,\nзнаешь ли."],[22.07,23.16,"Паудер."],[23.99,25.12,"Глупо, да?"],[25.95,28.37,"Я думала, что избавилась от нее\nнавсегда, но…"],[29.37,31.28,"…ты чем-то напоминаешь мне ее."],[42.45,44.87,"Это Сэйвика тебя подговорила?"]]}},{"n":197,"id":"dzhentlmeny-serial-s1e2-214","title":"Джентльмены","year":2024,"season":1,"episode":2,"path":"/k/1435343/s1e2","posters":["https://st.kp.yandex.net/images/film_iphone/iphone360_1435343.jpg"],"ratings":{"kp":7.9,"imdb":8},"audio":"EN","duration":70.15,"mediaStart":0.091,"frameRate":24,"videoLead":0,"clockOrigin":869.4,"focusVersion":4,"focus":[[0,0.8306,1],[0.7007,0.4944,1],[10.2423,0.8333,1],[16.2007,0.4389,1],[18.4923,0.725,1],[20.2007,0.4611,1],[21.6173,0.7222,1],[24.2423,0.4111,1],[31.534,0.7028,1],[33.659,0.4361,1],[38.7007,0.7194,1],[40.1173,0.4001,1],[40.6173,0.3997,0],[40.784,0.3971,0],[40.9507,0.389,0],[41.3673,0.3632,0],[41.534,0.3555,0],[41.7007,0.3536,0],[42.0757,0.7417,1],[44.0757,0.8333,1],[45.409,0.1667,1],[48.2423,0.2222,1],[49.8673,0.4972,1],[52.4507,0.1667,1],[54.3673,0.2778,1],[58.8257,0.6111,1],[60.8257,0.1667,1],[65.784,0.2611,1],[69.034,0.4889,1]],"cutLooks":[[0.7007,"E5UyQjNVM1JkRSRBY0VHMXE1h0KBRoiI","ZTQhJGZGIRNlRiISVTQiEmQ3RBJUiHd3"],[10.242