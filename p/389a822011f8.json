31,7.34,"Два воина.\nДек и Тиа на охоте."],[9.51,11.18,"Короткий вопрос."],[11.28,12.58,"А мне что нужно делать?"],[16.79,18.83,"Что это за существо?"],[20.22,22.79,"Костяной бизон.\nКалиск ими питается."],[24.63,28.17,"Значит он станет пищей и для меня."],[28.2,31.57,"Ой, как волнительно.\nОхота вместе с яутжа."],[31.67,32.7,"Тесса ни за что не поверит."],[35.27,36.54,"Давай только аккуратнее..."],[36.67,38.29,"Молчи, инструмент!"],[41.71,42.71,"Трава-лезвие."],[46.35,49.19,"Она тебя на лоскуты порежет.\nДавай просто обойдём."],[52.08,54.38,"Ты слишком легко сдаёшься."],[58.36,60.66,"Кажется, мы не одни тут охотимся."],[70.94,72.34,"Что за странный зверёк."],[72.44,74.48,"Первый раз такого вижу."],[79.98,81.95,"Тиа. Рада знакомству."],[97.3,98.84,"Похоже, твой конкурент превосходит тебя."]]}},{"n":170,"id":"ukrytie-s1e1-429","title":"Укрытие","year":2023,"season":1,"episode":1,"path":"/k/4541515/s1e1","posters":["https://st.kp.yandex.net/images/film_iphone/iphone360_4541515.jpg"],"ratings":{"kp":7.7,"imdb":8.1},"audio":"EN","duration":81.638,"mediaStart":0.437,"frameRate":25,"videoLead":0.117333,"clockOrigin":2317.402667,"focusVersion":4,"focus":[[0,0.5,1],[13.2803,0.5903,1],[14.7803,0.5906,0],[15.1137,0.5932,0],[15.6137,0.6073,0],[16.697,0.6471,0],[17.1137,0.6607,0],[17.447,0.6681,0],[17.697,0.6693,0],[18.197,0.6667,0],[18.7803,0.6596,0],[21.197,0.6131,0],[22.197,0.6003,0],[24.6137,0.5936,0],[28.0003,0.405,1],[32.0003,0.396,0],[32.0837,0.3973,0],[32.667,0.4179,0],[33.0837,0.4296,0],[33.5003,0.4382,0],[33.917,0.4441,0],[34.667,0.4499,0],[36.3337,0.4566,0],[37.3337,0.4555,0],[38.0003,0.4481,0],[38.2503,0.4426,0],[38.5003,0.4334,0],[38.667,0.4235,0],[38.8337,0.4092,0],[39.0003,0.3897,0],[39.2503,0.354,0],[39.3337,0.3454,0],[39.417,0.344,0],[39.5003,0.3499,0],[39.5837,0.3625,0],[39.667,0.3801,0],[39.7503,0.4011,0],[40.0837,0.4916,0],[40.167,0.5117,0],[40.2503,0.5275,0],[40.3337,0.5363,0],[40.417,0.5353,0],[40.5003,0.5213,0],[40.5837,0.4949,0],[40.7503,0.4305,0],[40.8337,0.4049,0],[40.917,0.387,0],[41.0003,0.3765,0],[41.0837,0.3715,0],[41.2503,0.3695,0],[43.167,0.3656,0],[43.3337,0.3622,0],[43.417,0.3585,0],[43.8337,0.3353,0],[44.0003,0.3284,0],[44.2503,0.326,0],[44.5837,0.3279,0],[45.0003,0.3339,0],[45.417,0.3431,0],[45.8337,0.3552,0],[46.3337,0.3732,0],[46.8337,0.3947,0],[47.2503,0.4157,0],[47.667,0.4397,0],[48.0837,0.4674,0],[48.3337,0.4866,0],[48.5003,0.5014,0],[48.667,0.5188,0],[48.8337,0.5395,0],[49.0003,0.5642,0],[49.167,0.5935,0],[49.5837,0.6801,0],[49.667,0.6936,0],[49.7503,0.7033,0],[49.8337,0.7095,0],[49.917,0.7127,0],[50.3337,0.7156,0],[57.2503,0.7336,0],[59.917,0.7429,0],[60.5003,0.7474,0],[61.5003,0.7619,0],[62.0837,0.7647,0],[63.417,0.7663,0],[63.5003,0.7654,0],[63.5837,0.7601,0],[63.667,0.7463,0],[63.7503,0.7208,0],[63.8337,0.6826,0],[64.0003,0.5877,0],[64.0837,0.5467,0],[64.167,0.5169,0],[64.2503,0.4985,0],[64.3337,0.4894,0],[64.417,0.4863,0]],"cutLooks":[[13.2803,"ERIiIRETZDESEiIxExIiIhESIiIRERER","ERE0mxESMXsREjFIEREiJBESREIRFFVV"],[28.0003,"FNuKkhN0JVISIiIiIjQzIhNVRUQRNVVV","SIR2ISIyIhEiIiIRIiEiESETEhEhFCIi"]],"captions":{"en":[[1,2,"Oh, God."],[34.99,37.33,"- There has to be something.\n- There isn't."],[37.41,41.54,"We could say she was distressed\nor that she misspoke or people misheard."],[42.17,45.55,"There were people there.\nThey heard what they heard."],[45.63,48.05,"- Maybe we could…\n- We can bribe them, kill them."],[48.13,49.22,"No, goddamn it."],[50.47,54.6,"The Pact says you can request a hearing\nif you feel you have been misheard."],[54.68,56.6,"Allison does not feel she was misheard."],[57.43,59.43,"Don't you want to at least\nlook at the possibility?"],[59.52,60.98,"Of course I do!"],[62.06,65.81,"Don't you think I've gone over it again\nand again? There is nothing I can do."],[70.99,74.7,"If you boil the Pact down to one rule,"],[75.33,80.04,"it's do not say you want to go outside\nor you will fucking go outside."]],"ru":[[1,2,"Боже."],[34.99,37.33,"- Что-то же можно сделать.\n- Нет, увы."],[37.41,41.54,"Скажем, под влиянием стресса.\nОговорилась, ее не так поняли."],[42.17,45.55,"Были свидетели.\nИм рот не заткнешь."],[45.63,48.05,"- Ну, можно…\n- Что? Дать взятку? Убить?"],[48.13,49.22,"Черт. Да хватит!"],[50.47,54.6,"Устав гласит, можно запросить слушание,\nмотивируя оговоркой."],[54.68,56.6,"Эллисон высказалась без оговорок."],[57.43,59.43,"- Но надо же перебрать варианты."],[59.52,60.98,"- Уже перебрал!"],[62.06,65.81,"Думаете, не прогоняю их в уме?\nЛазеек нет, ни одной!"],[70.99,74.7,"Если ужать Устав\nдо одного закона,"],[75.33,80.04,"им будет «хочешь наружу –\nполучай коленом под зад»!"]]}}]}