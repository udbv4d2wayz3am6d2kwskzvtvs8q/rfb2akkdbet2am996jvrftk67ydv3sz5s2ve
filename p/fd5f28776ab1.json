ь!»\nУмеешь кричать по-птичьи?"],[30.38,32.73,"- Нет, есть идея.\n- Алан, молчи, я думаю."],[32.9,36.65,"- Но у меня есть план.\n- Пожалуйста, дай мне всё обдумать…"],[36.82,40.04,"- Погоди, они стреляют в тебя.\n- Да, поэтому мы прячемся."],[40.21,42.56,"Нет. Они стреляют только в тебя."],[42.74,45.35,"В меня стрелять не станут.\nМой мозг слишком ценный."],[45.52,49.05,"По-моему, иногда ты вообще\nне соображаешь, что говоришь."]]}},{"n":66,"id":"krasotka-831","title":"Красотка","year":1990,"season":0,"episode":0,"path":"/k/8125","posters":["https://jbofvi6q36.a.trbcdn.net/prod/media/torrents/poster_mini/torrents/poster_mini/prettywoman-ecb875ec334911ed841d3cecef228558-341x512.webp","https://st.kp.yandex.net/images/film_iphone/iphone360_8125.jpg"],"ratings":{"kp":8,"imdb":7.1},"audio":"EN","duration":32.908,"mediaStart":5.021,"frameRate":24,"videoLead":0.122667,"clockOrigin":3651.402333,"focusVersion":4,"focus":[[0,0.68,1],[1.0183,0.6797,0],[1.185,0.6777,0],[1.2683,0.6731,0],[1.3517,0.6646,0],[1.685,0.6166,0],[1.7683,0.6071,0],[1.8517,0.6,0],[2.0183,0.5923,0],[2.5183,0.588,0],[3.8517,0.5855,0],[3.935,0.5895,0],[4.0183,0.6011,0],[4.1017,0.6227,0],[4.185,0.6545,0],[4.3517,0.7329,0],[4.435,0.7636,0],[4.5183,0.7813,0],[4.6017,0.7833,0],[10.2683,0.7833,0],[10.3517,0.7771,0],[10.435,0.7526,0],[10.5183,0.7149,0],[10.685,0.6296,0],[10.7683,0.5954,0],[10.8517,0.571,0],[10.935,0.5562,0],[11.0183,0.549,0],[11.1017,0.5466,0],[12.1017,0.5464,0],[14.185,0.5517,0],[14.3517,0.5558,0],[14.435,0.5596,0],[15.185,0.6063,0],[15.435,0.6127,0],[16.8517,0.6155,0],[19.1017,0.6855,1],[19.935,0.6876,0],[22.0183,0.7032,0],[22.8517,0.7027,0],[23.185,0.6999,0],[23.2683,0.6957,0],[23.3517,0.6877,0],[23.435,0.6751,0],[23.5183,0.6577,0],[23.7683,0.5932,0],[23.8517,0.5751,0],[23.935,0.5629,0],[24.0183,0.5567,0],[24.1017,0.5547,0],[24.2683,0.3494,1],[25.0183,0.3504,0],[25.1017,0.3538,0],[25.185,0.3613,0],[25.2683,0.373,0],[25.3517,0.3883,0],[25.435,0.4063,0],[26.0183,0.545,0],[26.1017,0.5623,0],[26.1