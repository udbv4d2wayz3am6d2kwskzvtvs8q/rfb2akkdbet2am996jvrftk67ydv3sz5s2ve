.25,6.67,"Ты недооцениваешь склонность к насилию\nбелых гетеросексуальных мужчин, Айзек."],[6.76,8.55,"Плевать мне, сколько им там лет."],[8.63,11.64,"А твоя история? Это полная лажа, Эван."],[11.72,13.6,"Мясник совершил\nнесколько убийств в 90-е."],[13.72,15.02,"А потом он исчез 20 лет назад."],[15.22,16.48,"Остальное всё - местные байки."],[16.56,18.68,"Разве не Мясник еще раньше"],[18.77,19.89,"убил нескольких ребят\nна школьном балу?"],[19.98,21.69,"Не на балу. На вечере выпускников."],[22.11,24.77,"Блиссфилдский Мясник всегда убивает\nв вечер выпускников."],[25.19,27.82,"И каждый год на выпускной неделе"],[27.9,29.99,"возникает новый миф,\nчтобы молодежь города не забывала"],[30.07,32.45,"об опасностях «ранних излишеств»."],[33.24,35.53,"Какой будет история этого года?"]]}},{"n":69,"id":"dostat-nozhi-voskreshenie-pokoynika-57","title":"Достать ножи: Воскрешение покойника","year":2025,"season":0,"episode":0,"path":"/k/4421816","posters":["https://st.kp.yandex.net/images/film_iphone/iphone360_4421816.jpg"],"ratings":{"kp":7.2,"imdb":7.3},"audio":"EN","duration":60.709,"mediaStart":0.791,"frameRate":24,"videoLead":0.122667,"clockOrigin":267.402333,"focusVersion":4,"focus":[[0,0.5,1],[1.665,0.4215,1],[3.3317,0.2146,1],[7.5817,0.2146,0],[7.665,0.2179,0],[7.7483,0.2312,0],[7.8317,0.2507,0],[8.165,0.3498,0],[8.3317,0.3944,0],[8.415,0.4136,0],[8.4983,0.4307,0],[8.665,0.4589,0],[8.7483,0.4703,0],[8.915,0.4886,0],[9.0817,0.5025,0],[9.3317,0.5183,0],[9.665,0.5352,0],[10.0817,0.5527,0],[10.7483,0.5727,0],[11.415,0.5835,0],[11.8317,0.5849,0],[12.4983,0.5811,0],[15.4983,0.5434,0],[16.4983,0.5349,0],[17.415,0.5308,0],[27.915,0.5614,0],[28.0817,0.5553,0],[28.7483,0.5188,0],[29.2483,0.4953,0],[29.665,0.4793,0],[29.9983,0.4718,0],[30.3317,0.4706,0],[30.7483,0.472,0],[32.4983,0.4924,0],[33.165,0.4959,0],[33.4983,0.4955,0],[33.5817,0.4907,0],[33.665,0.4796,0],[33.7483,0.461,0],[33.915,0.4117,0],[33.9983,0.3914,0],[34.0817,0.3786,0],[34.165,0.3727,0],[34.3317,0.3713,0],[36.2483,0.3